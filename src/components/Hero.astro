---
import { person } from '../data/site';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="stage">
    <canvas id="swarm" aria-hidden="true"></canvas>
    <div class="phase mono" aria-hidden="true">
      <span class="from">More model · persona agents · MCP servers · watchers</span>
      <span class="now">→ <b>Less model</b> · one script, a model only for real work</span>
    </div>
    <div class="copy">
      <h1 id="hero-title"><span class="line"><span class="li">Connor</span></span><span class="line"><span class="li">Dos Santos</span></span><span class="line"><span class="li">Cates<span class="serif">.</span></span></span></h1>
      <div class="meta mono">{person.positioning} · Boston<p>{person.bio}</p></div>
    </div>
    <div class="scrollhint mono" aria-hidden="true"><span>Scroll</span><i></i></div>
  </div>
</section>

<style>
  .hero { height: 320vh; position: relative; }
  .stage { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .copy { position: absolute; left: var(--gutter); right: var(--gutter); bottom: 9vh; display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 32px; pointer-events: none; }
  h1 { font-size: clamp(48px, 9vw, 150px); line-height: .86; letter-spacing: -.055em; font-weight: 500; }
  .line { display: block; overflow: hidden; padding-bottom: .04em; }
  .li { display: block; }
  :global(html.js) .li { transform: translateY(110%); }
  h1 .serif { letter-spacing: -.02em; color: var(--accent); }
  .meta { text-align: right; color: var(--muted); max-width: 300px; }
  .meta p { font-family: var(--sans); text-transform: none; letter-spacing: 0; font-size: 15px; line-height: 1.5; margin-top: 10px; color: var(--text); }
  .phase { position: absolute; top: 96px; left: var(--gutter); right: var(--gutter); display: flex; justify-content: space-between; gap: 24px; color: var(--muted); }
  .phase .now { color: var(--text); opacity: .25; }
  .phase b { color: var(--accent); font-weight: 400; }
  .scrollhint { position: absolute; left: 50%; bottom: 28px; transform: translateX(-50%); color: var(--dim); display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .scrollhint i { width: 1px; height: 40px; background: linear-gradient(var(--muted), transparent); animation: drip 1.8s var(--ease) infinite; transform-origin: top; }
  @keyframes drip { 0% { transform: scaleY(0) } 50% { transform: scaleY(1) } 100% { transform: scaleY(1); opacity: 0 } }
  :global(html.js) .meta, :global(html.js) .phase { opacity: 0; }
  @media (max-width: 860px) {
    .hero { height: 260vh; }
    .copy { grid-template-columns: 1fr; } .meta { text-align: left; }
    .phase .from, .scrollhint { display: none; } .phase { justify-content: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) { .hero { height: 100vh; } }
</style>

<script>
  import { gsap, ScrollTrigger, ready, reduce } from '../scripts/core';

  const cv = document.getElementById('swarm') as HTMLCanvasElement;
  const ctx = cv.getContext('2d')!;
  const DPR = Math.min(devicePixelRatio, 2);
  let W = 0, H = 0;
  const size = () => { W = cv.clientWidth; H = cv.clientHeight; cv.width = W * DPR; cv.height = H * DPR; ctx.setTransform(DPR, 0, 0, DPR, 0, 0); };
  size(); addEventListener('resize', size);

  // Each particle is an "agent". Scroll morphs the swarm into one evenly spaced line: the script.
  const N = innerWidth < 700 ? 140 : 260;
  const P = Array.from({ length: N }, (_, i) => ({ a: Math.random() * Math.PI * 2, r: Math.random(), s: 0.2 + Math.random() * 0.8, ph: Math.random() * 100, x: W * 0.62, y: H * 0.42, ox: 0, oy: 0, k: i / (N - 1) }));
  const state = { morph: reduce ? 1 : 0, intro: reduce ? 1 : 0 };
  const cm = { x: -999, y: -999 };
  const stage = cv.parentElement!;
  stage.addEventListener('pointermove', (e) => { const b = cv.getBoundingClientRect(); cm.x = e.clientX - b.left; cm.y = e.clientY - b.top; });
  stage.addEventListener('pointerleave', () => { cm.x = cm.y = -999; });

  let t = 0, visible = true;
  function draw() {
    if (!visible) return;
    if (!reduce) t += 0.006;
    ctx.clearRect(0, 0, W, H);
    const mobile = W < 700;
    const cx = W * (mobile ? 0.5 : 0.62), cy = H * 0.42, R = Math.min(W, H) * 0.34;
    const m = state.morph, ease = m < 0.5 ? 4 * m * m * m : 1 - Math.pow(-2 * m + 2, 3) / 2;
    const lineY = H * 0.42, x0 = W * 0.12, x1 = W * 0.88;
    for (const p of P) {
      const ang = p.a + t * p.s * (p.r > 0.5 ? 1 : -1);
      const rr = R * (0.25 + p.r * 0.85) + Math.sin(t * 3 + p.ph) * 18;
      const sx = cx + Math.cos(ang) * rr * 1.25, sy = cy + Math.sin(ang) * rr * 0.8;
      const lx = x0 + (x1 - x0) * p.k, ly = lineY + Math.sin(p.k * 18 + t * 4) * 3 * (1 - ease * 0.7);
      const tx = sx + (lx - sx) * ease, ty = sy + (ly - sy) * ease;
      const dx = tx - cm.x, dy = ty - cm.y, d = Math.hypot(dx, dy) || 1;
      if (d < 140) { const f = (1 - d / 140) * 60; p.ox += (dx / d * f - p.ox) * 0.2; p.oy += (dy / d * f - p.oy) * 0.2; }
      else { p.ox *= 0.9; p.oy *= 0.9; }
      p.x += (tx + p.ox - p.x) * 0.12; p.y += (ty + p.oy - p.y) * 0.12;
    }
    const links = (1 - ease) * 0.9 * state.intro;
    if (links > 0.02) {
      ctx.lineWidth = 0.6;
      for (let i = 0; i < N; i += 2) for (let j = i + 1; j < Math.min(N, i + 14); j++) {
        const a = P[i], b = P[j], dd = (a.x - b.x) ** 2 + (a.y - b.y) ** 2;
        if (dd < 4900) { ctx.strokeStyle = `rgba(255,255,255,${(1 - dd / 4900) * 0.16 * links})`; ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke(); }
      }
    }
    if (ease > 0.4) { ctx.strokeStyle = `rgba(255,91,46,${(ease - 0.4) * 0.8})`; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(x0, lineY); ctx.lineTo(x0 + (x1 - x0) * Math.min(1, (ease - 0.4) / 0.6), lineY); ctx.stroke(); }
    for (const p of P) {
      ctx.fillStyle = `rgba(237,237,238,${(0.35 + p.r * 0.6) * state.intro})`;
      ctx.beginPath(); ctx.arc(p.x, p.y, (1.1 + p.r * 1.4) * (1 - ease * 0.35), 0, 7); ctx.fill();
    }
    // A single accent pulse: the one model run that's left.
    if (ease > 0.9) { const px = x0 + ((t * 0.25) % 1) * (x1 - x0); ctx.fillStyle = '#ff5b2e'; ctx.shadowColor = '#ff5b2e'; ctx.shadowBlur = 18; ctx.beginPath(); ctx.arc(px, lineY, 4, 0, 7); ctx.fill(); ctx.shadowBlur = 0; }
  }
  gsap.ticker.add(draw);
  ScrollTrigger.create({ trigger: '.hero', start: 'top bottom', end: 'bottom top', onToggle: (s) => (visible = s.isActive) });

  if (!reduce) {
    gsap.timeline({ scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom bottom', scrub: 0.6 } })
      .to(state, { morph: 1, ease: 'none' }, 0)
      .to('.hero .phase .from', { opacity: 0.25, ease: 'none' }, 0)
      .to('.hero .phase .now', { opacity: 1, ease: 'none' }, 0.2)
      .to('.hero h1', { yPercent: -18, opacity: 0.15, ease: 'none' }, 0.55)
      .to('.hero .scrollhint', { opacity: 0, duration: 0.1 }, 0);
  }

  ready.then(() => {
    gsap.timeline({ defaults: { ease: 'expo.out' } })
      .to('.hero .li', { y: 0, duration: reduce ? 0 : 1.4, stagger: 0.1 })
      .to(state, { intro: 1, duration: reduce ? 0 : 2, ease: 'power2.out' }, 0)
      .fromTo('.hero .meta, .hero .phase', { y: 16 }, { opacity: 1, y: 0, duration: reduce ? 0 : 1, stagger: 0.08 }, 0.4);
  });
</script>
