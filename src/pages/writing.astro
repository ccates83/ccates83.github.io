---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { person } from '../data/site';

const all = (await getCollection('posts')).sort((a, b) => a.data.number - b.data.number);
const published = all.filter((p) => p.data.status === 'published');
const next = all.filter((p) => p.data.status === 'next');
---
<Base title="Writing" description="A series on running Claude Code at work: from a multi-agent framework to a shell dispatcher that starts a model only when there's real work.">
  <header class="page-head">
    <p class="label mono">Writing · on Medium</p>
    <h1 class="title"><span class="ln"><span class="li">How I run</span></span><span class="ln"><span class="li">Claude <span class="serif accent">at work.</span></span></span></h1>
    <p class="intro" data-reveal="fade">A series on five months of moving from <em>more model</em> to <em>less model</em>. Every claim has a number or an incident behind it. Posts are published on <a href={person.links.medium}>Medium</a>.</p>
  </header>
  <section class="section tight" aria-labelledby="pub"><h2 id="pub" class="label mono">Published · {published.length}</h2><PostList posts={published} /></section>
  <section class="section tight" aria-labelledby="up"><h2 id="up" class="label mono">Up next · {next.length}</h2><PostList posts={next} /></section>
</Base>

<style is:global>
  .page-head { padding: 180px var(--gutter) 40px; }
  .page-head .title { font-size: clamp(56px, 10vw, 160px); line-height: .9; letter-spacing: -.055em; font-weight: 500; }
  .page-head .ln { display: block; overflow: hidden; padding-bottom: .05em; }
  .page-head .li { display: block; }
  html.js .page-head .li { transform: translateY(110%); }
  .page-head .intro { color: var(--muted); font-size: 20px; max-width: 52ch; margin-top: 40px; }
  .page-head .intro em { color: var(--text); font-style: normal; }
  .page-head .intro a { color: var(--text); border-bottom: 1px solid var(--accent); }
  .section.tight { padding-top: 64px; padding-bottom: 64px; }
</style>

<script>
  import { gsap, ready, reduce } from '../scripts/core';
  ready.then(() => gsap.to('.page-head .li', { y: 0, duration: reduce ? 0 : 1.3, stagger: 0.1, ease: 'expo.out', delay: 0.15 }));
</script>
