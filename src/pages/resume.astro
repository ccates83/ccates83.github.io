---
import Base from '../layouts/Base.astro';
import { person, jobs, education, skills } from '../data/site';
---
<Base title="Résumé" description={`${person.fullName} — ${person.role} at ${person.company}. Résumé.`}>
  <header class="page-head">
    <p class="label mono">Résumé</p>
    <h1 class="title"><span class="ln"><span class="li">{person.fullName.split(' ').slice(0, 1)}</span></span><span class="ln"><span class="li">{person.fullName.split(' ').slice(1).join(' ')}<span class="serif accent">.</span></span></span></h1>
    <div class="meta" data-reveal="fade">
      <span>{person.role}, {person.company}</span><span>{person.location}</span>
      <a href={`mailto:${person.email}`}>{person.email}</a><a href={person.links.github}>github.com/ccates83</a><a href={person.links.linkedin}>linkedin.com/in/connorcates</a>
    </div>
    <button class="print mono" type="button" data-print>Save as PDF ↓</button>
  </header>

  <section class="section tight grid" aria-labelledby="exp">
    <h2 id="exp" class="label mono">Experience</h2>
    <div>
      {jobs.map((j) => (
        <article class="item" data-reveal="fade">
          <div class="row"><h3>{j.title} <span>· {j.org}</span></h3><span class="when mono">{j.when}</span></div>
          <p>{j.body}</p>
          <div class="chips">{j.stack.map((s) => <span>{s}</span>)}</div>
        </article>
      ))}
    </div>
  </section>

  <section class="section tight grid" aria-labelledby="edu">
    <h2 id="edu" class="label mono">Education</h2>
    <article class="item" data-reveal="fade"><div class="row"><h3>{education.degree} <span>· {education.school}</span></h3></div><p>{education.body}</p></article>
  </section>

  <section class="section tight grid" aria-labelledby="sk">
    <h2 id="sk" class="label mono">Skills</h2>
    <div class="skills">
      {skills.map((s) => (<div data-reveal="fade"><h3 class="mono">{s.group}</h3><ul>{s.items.map((i) => <li>{i}</li>)}</ul></div>))}
    </div>
  </section>

  <section class="section tight grid" aria-labelledby="ind">
    <h2 id="ind" class="label mono">Independent</h2>
    <div>
      <article class="item" data-reveal="fade"><div class="row"><h3>Writing <span>· Medium</span></h3><span class="when mono">2026 — Now</span></div><p>A series on running Claude Code at work: moving from a multi-agent framework to a script-first dispatcher, with the measurements behind each step.</p></article>
      <article class="item" data-reveal="fade"><div class="row"><h3>Fin <span>· iOS app</span></h3><span class="when mono">TestFlight</span></div><p>Puppy routine tracker with hand-rolled CloudKit sync (CKSyncEngine, a shareable record zone per dog), widgets and App Intents.</p></article>
    </div>
  </section>
</Base>

<style is:global>
  .page-head { padding: 180px var(--gutter) 40px; }
  .page-head .title { font-size: clamp(56px, 10vw, 160px); line-height: .9; letter-spacing: -.055em; font-weight: 500; }
  .page-head .ln { display: block; overflow: hidden; padding-bottom: .05em; }
  .page-head .li { display: block; }
  html.js .page-head .li { transform: translateY(110%); }
  .section.tight { padding-top: 64px; padding-bottom: 64px; }
</style>
<style>
  .meta { display: flex; flex-wrap: wrap; gap: 10px 28px; margin-top: 40px; color: var(--muted); font-size: 16px; }
  .meta a { color: var(--text); border-bottom: 1px solid var(--line); transition: border-color .3s; } .meta a:hover { border-color: var(--accent); }
  .print { margin-top: 36px; border: 1px solid var(--line); border-radius: 99px; padding: 12px 20px; transition: border-color .3s, background .3s; }
  .print:hover { border-color: var(--accent); background: var(--bg2); }
  .grid { display: grid; grid-template-columns: 240px 1fr; gap: 48px; border-top: 1px solid var(--line); }
  .grid .label { margin-bottom: 0; align-self: start; }
  .item + .item { margin-top: 48px; }
  .row { display: flex; justify-content: space-between; gap: 24px; align-items: baseline; flex-wrap: wrap; }
  h3 { font-size: 26px; font-weight: 500; letter-spacing: -.02em; }
  h3 span { color: var(--muted); font-weight: 300; }
  .when { color: var(--dim); }
  .item p { color: var(--muted); font-size: 17px; margin-top: 10px; max-width: 64ch; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
  .chips span { font-family: var(--mono); font-size: 11px; text-transform: uppercase; border: 1px solid var(--line); border-radius: 99px; padding: 4px 10px; color: var(--muted); }
  .skills { display: grid; grid-template-columns: repeat(2, 1fr); gap: 40px; }
  .skills h3 { color: var(--accent); margin-bottom: 12px; font-size: 12px; }
  .skills ul { list-style: none; display: grid; gap: 6px; font-size: 18px; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; gap: 28px; } .skills { grid-template-columns: 1fr; } }

  @media print {
    :global(nav.top), :global(.footer), :global(.cursor), :global(.cursor-ring), :global(.progress), :global(.skip), .print { display: none !important; }
    :global(html), :global(body) { background: #fff !important; color: #111 !important; }
    :global(body::after) { display: none; }
    :global(.page-head) { padding: 0 0 16px !important; }
    :global(.page-head .title) { font-size: 40px !important; color: #111; }
    :global(.page-head .li) { transform: none !important; }
    :global(.section.tight) { padding: 14px 0 !important; break-inside: avoid; }
    :global(.label) { color: #555 !important; }
    :global([data-reveal]) { opacity: 1 !important; transform: none !important; }
    .meta, .item p, h3 span, .when, .chips span, .meta a { color: #333 !important; }
    h3 { font-size: 16px; } .item p { font-size: 12px; } .item + .item { margin-top: 14px; }
    .grid { grid-template-columns: 140px 1fr; gap: 16px; border-color: #ddd; }
    .skills ul { font-size: 12px; }
  }
</style>

<script>
  import { gsap, ready, reduce } from '../scripts/core';
  ready.then(() => gsap.to('.page-head .li', { y: 0, duration: reduce ? 0 : 1.3, stagger: 0.1, ease: 'expo.out', delay: 0.15 }));
  document.querySelector('[data-print]')?.addEventListener('click', () => print());
</script>
