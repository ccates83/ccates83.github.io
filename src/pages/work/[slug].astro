---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({ params: { slug: project.id }, props: { project, next: projects[(i + 1) % projects.length] } }));
}
const { project, next } = Astro.props;
const p = project.data;
const { Content } = await render(project);
---
<Base title={p.title} description={p.summary}>
  <article>
    <header class="page-head">
      <a class="back mono" href="/#work">← All work</a>
      <p class="label mono">{p.kind} · {p.status}</p>
      <h1 class="title"><span class="ln"><span class="li">{p.title}<span class="serif accent">.</span></span></span></h1>
      <p class="lede" data-reveal="fade">{p.summary}</p>
      <dl class="facts" data-reveal="fade">
        <div><dt class="mono">Role</dt><dd>{p.role}</dd></div>
        <div><dt class="mono">Status</dt><dd>{p.status}</dd></div>
        <div><dt class="mono">Stack</dt><dd>{p.stack.join(' · ')}</dd></div>
        {p.links.length > 0 && <div><dt class="mono">Links</dt><dd>{p.links.map((l) => <a href={l.href}>{l.label} ↗</a>)}</dd></div>}
      </dl>
    </header>
    <div class:list={['hero-vis', p.theme]}><ProjectVisual kind={p.visual} /></div>
    <div class="section body"><div class="prose" data-reveal="fade"><Content /></div></div>
  </article>
  <a class="next" href={`/work/${next.id}`} data-cursor="big" data-cursor-label="Next">
    <span class="mono">Next project</span>
    <span class="nt">{next.data.title} <span class="arrow">→</span></span>
  </a>
</Base>

<style is:global>
  .page-head { padding: 180px var(--gutter) 40px; }
  .page-head .title { font-size: clamp(56px, 11vw, 180px); line-height: .9; letter-spacing: -.055em; font-weight: 500; }
  .page-head .ln { display: block; overflow: hidden; padding-bottom: .05em; }
  .page-head .li { display: block; }
  html.js .page-head .li { transform: translateY(110%); }
</style>
<style>
  .back { display: inline-block; color: var(--muted); margin-bottom: 40px; transition: color .3s, transform .5s var(--ease); }
  .back:hover { color: var(--text); transform: translateX(-6px); }
  .lede { font-size: clamp(20px, 2vw, 26px); max-width: 40ch; margin-top: 32px; letter-spacing: -.01em; }
  .facts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-top: 64px; border-top: 1px solid var(--line); padding-top: 24px; }
  .facts dt { color: var(--dim); margin-bottom: 8px; }
  .facts dd { font-size: 15px; color: var(--muted); display: flex; flex-direction: column; gap: 4px; }
  .facts a { color: var(--text); } .facts a:hover { color: var(--accent); }
  .hero-vis { margin: 40px var(--gutter) 0; height: 72vh; border-radius: 20px; overflow: hidden; }
  .hero-vis :global(.vis) { height: 100%; border-radius: 20px; }
  .body { padding-top: 120px; display: flex; justify-content: center; }
  .next { display: block; padding: 120px var(--gutter); border-top: 1px solid var(--line); color: var(--muted); transition: background .5s var(--ease); }
  .next:hover { background: var(--bg2); }
  .nt { display: block; color: var(--text); font-size: clamp(48px, 9vw, 140px); letter-spacing: -.055em; font-weight: 500; line-height: 1; margin-top: 16px; }
  .arrow { display: inline-block; color: var(--accent); transition: transform .6s var(--ease); }
  .next:hover .arrow { transform: translateX(24px); }
  @media (max-width: 860px) { .facts { grid-template-columns: 1fr 1fr; } .hero-vis { height: 52vh; } .body { padding-top: 72px; } }
</style>

<script>
  import { gsap, ready, reduce } from '../../scripts/core';
  ready.then(() => {
    gsap.to('.page-head .li', { y: 0, duration: reduce ? 0 : 1.3, ease: 'expo.out', delay: 0.15 });
    if (!reduce) gsap.fromTo('.hero-vis', { clipPath: 'inset(12% 8% 0% 8% round 20px)' }, { clipPath: 'inset(0% 0% 0% 0% round 20px)', ease: 'none', scrollTrigger: { trigger: '.hero-vis', start: 'top 95%', end: 'top 25%', scrub: true } });
  });
</script>
